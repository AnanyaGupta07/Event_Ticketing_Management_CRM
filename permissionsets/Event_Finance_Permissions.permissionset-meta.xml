<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants Finance Team access to track incoming payments, transaction settlements, and event revenue realization.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Event Finance Permissions</label>

    <!-- Object Permissions: Payment__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Payment__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Registration__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Registration__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Event__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Event__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Ticket_Type__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Ticket_Type__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Field Permissions: Payment__c -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Payment__c.Transaction_Reference__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field Permissions: Registration__c -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Registration__c.Confirmation_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Registration__c.Feedback_Submitted__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Registration__c.Booking_Group_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field Permissions: Event__c -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Description__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Organizer__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Total_Capacity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Booked_Seats__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Available_Seats__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Event__c.Proposed_Budget__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Approved_By__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field Permissions: Ticket_Type__c -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Ticket_Type__c.Booked_Seats__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Ticket_Type__c.Available_Seats__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Ticket_Type__c.Description__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Tab Visibility -->
    <tabSettings>
        <tab>Event__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Payment__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Registration__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <!-- Application Visibility -->
    <applicationVisibilities>
        <application>Event_Management</application>
        <visible>true</visible>
    </applicationVisibilities>

    <!-- Apex Class Accesses -->
    <classAccesses>
        <apexClass>EventApprovalService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Custom Metadata Type Accesses -->
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Approval_Matrix__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Payment_Gateway_Config__mdt</name>
    </customMetadataTypeAccesses>
</PermissionSet>
