<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants Speaker Coordinators access to manage keynote speakers, bios, sessions, and track venue assignments.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Event Speaker Coordinator Permissions</label>

    <!-- Object Permissions: Speaker__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Speaker__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Event__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Event__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Object Permissions: Venue__c (Read Only) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Venue__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Field Permissions: Speaker__c -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Speaker__c.Bio__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Speaker__c.Email__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Speaker__c.Event__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Speaker__c.Expertise__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Speaker__c.Organization__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Speaker__c.Phone__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field Permissions: Event__c (Read Only) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Description__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Organizer__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Total_Capacity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Booked_Seats__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Event__c.Available_Seats__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field Permissions: Venue__c (Read Only) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Venue__c.Address__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Venue__c.Contact_Person__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Venue__c.Contact_Phone__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Tab Visibility -->
    <tabSettings>
        <tab>Event__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Speaker__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Venue__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <!-- Application Visibility -->
    <applicationVisibilities>
        <application>Event_Management</application>
        <visible>true</visible>
    </applicationVisibilities>
</PermissionSet>
