<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Record-Triggered Flow on Registration__c firing when Registration_Status__c flips to Confirmed. Generates Ticket__c, logs follow-up Task, sends confirmation email, and updates Confirmation_Status__c.</description>
    <environments>Default</environments>
    <interviewLabel>Post Registration Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Post Registration Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Ticket</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Registration_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </filters>
        <object>Registration__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <actionCalls>
        <name>Send_Confirmation_Email</name>
        <label>Send Confirmation Email</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Set_Confirmation_Sent</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Confirmation_Failed</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Attendee__r.Email__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>formulaEmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>formulaEmailBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <formulas>
        <name>formulaTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Registration Confirmation: " &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>formulaEmailSubject</name>
        <dataType>String</dataType>
        <expression>"Your Event Ticket Confirmation: " &amp; {!$Record.Event__r.Name}</expression>
    </formulas>
    <formulas>
        <name>formulaEmailBody</name>
        <dataType>String</dataType>
        <expression>"Congratulations! Your registration for " &amp; {!$Record.Event__r.Name} &amp; " has been confirmed. Your ticket ID is: " &amp; {!varTicketId} &amp; ". Please keep this email for event admission."</expression>
    </formulas>
    <recordCreates>
        <name>Create_Ticket</name>
        <label>Create Ticket</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignRecordIdToReference>varTicketId</assignRecordIdToReference>
        <connector>
            <targetReference>Create_Confirmation_Task</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Confirmation_Failed</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Issue_Date_Time__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Registration__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Ticket_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <object>Ticket__c</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Confirmation_Task</name>
        <label>Create Confirmation Task</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Send_Confirmation_Email</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Registration confirmed and active ticket generated for attendee.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formulaTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Event__c</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordUpdates>
        <name>Set_Confirmation_Sent</name>
        <label>Set Confirmation Status Sent</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Confirmation_Status__c</field>
            <value>
                <stringValue>Sent</stringValue>
            </value>
        </inputAssignments>
        <object>Registration__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Confirmation_Failed</name>
        <label>Set Confirmation Status Failed</label>
        <locationX>440</locationX>
        <locationY>647</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Confirmation_Status__c</field>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </inputAssignments>
        <object>Registration__c</object>
    </recordUpdates>
    <variables>
        <name>varTicketId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>