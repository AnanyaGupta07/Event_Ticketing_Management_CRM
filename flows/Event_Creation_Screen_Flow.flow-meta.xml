        <defaultConnector>
            <targetReference>Get_Approval_Threshold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Speaker Selected</defaultConnectorLabel>
        <rules>
            <name>Speaker_Selected_Rule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_Speaker</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
