<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Schedule-Triggered Flow running hourly to send post-event feedback survey emails to confirmed attendees, with automatic deduplication against existing feedback.</description>
    <environments>Default</environments>
    <interviewLabel>Post Event Feedback Scheduled Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Post Event Feedback Scheduled Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Confirmed_Registrations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Approval_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Event__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-09-04</startDate>
            <startTime>01:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <actionCalls>
        <name>Send_Feedback_Email</name>
        <label>Send Feedback Email</label>
        <locationX>440</locationX>
        <locationY>684</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Loop_Registrations</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Loop_Registrations.Attendee__r.Email__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>formulaFeedbackSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>formulaFeedbackBody</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <decisions>
        <name>Decision_Feedback_Exists</name>
        <label>Feedback Already Exists?</label>
        <locationX>352</locationX>
        <locationY>576</locationY>
        <defaultConnector>
            <targetReference>Send_Feedback_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Feedback Yet</defaultConnectorLabel>
        <rules>
            <name>Feedback_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingFeedback</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Registrations</targetReference>
            </connector>
            <label>Feedback Found</label>
        </rules>
    </decisions>
    <formulas>
        <name>formulaFeedbackSubject</name>
        <dataType>String</dataType>
        <expression>"How was your experience at " &amp; {!$Record.Name} &amp; "?"</expression>
    </formulas>
    <formulas>
        <name>formulaFeedbackBody</name>
        <dataType>String</dataType>
        <expression>"Thank you for attending " &amp; {!$Record.Name} &amp; "! We value your opinion. Please take a moment to share your feedback and help us improve future sessions."</expression>
    </formulas>
    <loops>
        <name>Loop_Registrations</name>
        <label>Loop Registrations</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>colConfirmedRegistrations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Existing_Feedback</targetReference>
        </nextValueConnector>
    </loops>
    <recordLookups>
        <name>Get_Confirmed_Registrations</name>
        <label>Get Confirmed Registrations</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Registrations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Event__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Registration_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </filters>
        <object>Registration__c</object>
        <outputReference>colConfirmedRegistrations</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Attendee__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Check_Existing_Feedback</name>
        <label>Check Existing Feedback</label>
        <locationX>352</locationX>
        <locationY>468</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Feedback_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Registration__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Registrations.Id</elementReference>
            </value>
        </filters>
        <object>Feedback__c</object>
        <outputReference>varExistingFeedback</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <variables>
        <name>colConfirmedRegistrations</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Registration__c</objectType>
    </variables>
    <variables>
        <name>varExistingFeedback</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Feedback__c</objectType>
    </variables>
</Flow>