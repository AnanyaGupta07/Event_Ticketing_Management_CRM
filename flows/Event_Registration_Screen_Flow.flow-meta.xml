<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Screen Flow for Attendee self-registration, handling availability validation, attendee match/creation, review, and pending registration insertion.</description>
    <environments>Default</environments>
    <interviewLabel>Event Registration Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Event Registration Screen Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Ticket_Type_Details</targetReference>
        </connector>
    </start>
    <assignments>
        <name>Set_Outcome_SoldOut</name>
        <label>Set Outcome SoldOut</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SoldOut</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Sold_Out_Message</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Attendee_From_User</name>
        <label>Set Attendee From User</label>
        <locationX>170</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>varAttendeeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingAttendee.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Review_Screen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Attendee_From_Email</name>
        <label>Set Attendee From Email</label>
        <locationX>302</locationX>
        <locationY>998</locationY>
        <assignmentItems>
            <assignToReference>varAttendeeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingAttendee.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Review_Screen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Outcome_Success</name>
        <label>Set Outcome Success</label>
        <locationX>170</locationX>
        <locationY>1416</locationY>
        <assignmentItems>
            <assignToReference>outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Success</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Registration_Successful</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Outcome_Failed</name>
        <label>Set Outcome Failed</label>
        <locationX>434</locationX>
        <locationY>1416</locationY>
        <assignmentItems>
            <assignToReference>outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Registration_Failed</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Still_Available</name>
        <label>Is Still Available?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Attendee_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Available</defaultConnectorLabel>
        <rules>
            <name>Sold_Out</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varTicketType.Available_Seats__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varTicketType.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sold Out</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Outcome_SoldOut</targetReference>
            </connector>
            <label>Sold Out</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Attendee_Found_By_User</name>
        <label>Check Attendee Found By User</label>
        <locationX>302</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Attendee_By_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found By User</defaultConnectorLabel>
        <rules>
            <name>Found_By_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingAttendee</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Attendee_From_User</targetReference>
            </connector>
            <label>Found By User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Attendee_Found_By_Email</name>
        <label>Check Attendee Found By Email</label>
        <locationX>434</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>Create_Attendee</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New Attendee</defaultConnectorLabel>
        <rules>
            <name>Found_By_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingAttendee</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Attendee_From_Email</targetReference>
            </connector>
            <label>Found By Email</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Registration</name>
        <label>Create Registration</label>
        <locationX>302</locationX>
        <locationY>1308</locationY>
        <assignRecordIdToReference>newRegistrationId</assignRecordIdToReference>
        <connector>
            <targetReference>Set_Outcome_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Outcome_Failed</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Attendee__c</field>
            <value>
                <elementReference>varAttendeeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Booked_Price__c</field>
            <value>
                <elementReference>varTicketType.Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Confirmation_Status__c</field>
            <value>
                <stringValue>Not Sent</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Event__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Registration_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Ticket_Type__c</field>
            <value>
                <elementReference>selectedTicketTypeId</elementReference>
            </value>
        </inputAssignments>
        <object>Registration__c</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Attendee</name>
        <label>Create Attendee</label>
        <locationX>566</locationX>
        <locationY>998</locationY>
        <assignRecordIdToReference>varAttendeeId</assignRecordIdToReference>
        <connector>
            <targetReference>Review_Screen</targetReference>
        </connector>
        <inputAssignments>
            <field>Email__c</field>
            <value>
                <elementReference>Attendee_Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Attendee_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone__c</field>
            <value>
                <elementReference>Attendee_Phone</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Attendee_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>User__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Attendee__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Ticket_Type_Details</name>
        <label>Get Ticket Type Details</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Confirm_Selection</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>selectedTicketTypeId</elementReference>
            </value>
        </filters>
        <object>Ticket_Type__c</object>
        <outputReference>varTicketType</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Price__c</queriedFields>
        <queriedFields>Available_Seats__c</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <queriedFields>Event__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Attendee_By_User</name>
        <label>Get Existing Attendee By User</label>
        <locationX>302</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Attendee_Found_By_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>User__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <object>Attendee__c</object>
        <outputReference>varExistingAttendee</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Email__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Attendee_By_Email</name>
        <label>Get Existing Attendee By Email</label>
        <locationX>434</locationX>
        <locationY>782</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Attendee_Found_By_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Attendee_Email</elementReference>
            </value>
        </filters>
        <object>Attendee__c</object>
        <outputReference>varExistingAttendee</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Email__c</queriedFields>
    </recordLookups>
    <screens>
        <name>Confirm_Selection</name>
        <label>Confirm Selection</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Is_Still_Available</targetReference>
        </connector>
        <fields>
            <name>Selection_Header</name>
            <fieldText>&lt;p&gt;&lt;strong style="font-size: 16px;"&gt;Confirm Your Selection&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Please review the ticket type details before proceeding.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Selection_Details</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Ticket Type:&lt;/strong&gt; {!varTicketType.Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Price:&lt;/strong&gt; ${!varTicketType.Price__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Available Seats:&lt;/strong&gt; {!varTicketType.Available_Seats__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Sold_Out_Message</name>
        <label>Sold Out</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Sold_Out_Text</name>
            <fieldText>&lt;p style="color: #d9534f; font-weight: bold; font-size: 16px;"&gt;Sold Out&lt;/p&gt;&lt;p&gt;Sorry, this ticket type just sold out. Please choose another ticket type.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Attendee_Details</name>
        <label>Attendee Details</label>
        <locationX>302</locationX>
        <locationY>458</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Existing_Attendee_By_User</targetReference>
        </connector>
        <fields>
            <name>Attendee_Header</name>
            <fieldText>&lt;p&gt;&lt;strong style="font-size: 16px;"&gt;Your Contact Information&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Enter attendee details for registration and ticket confirmation.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Attendee_Name</name>
            <dataType>String</dataType>
            <fieldText>Full Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Attendee_Email</name>
            <dataType>String</dataType>
            <fieldText>Email Address</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Attendee_Phone</name>
            <dataType>String</dataType>
            <fieldText>Phone Number</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Review_Screen</name>
        <label>Review Registration</label>
        <locationX>302</locationX>
        <locationY>1200</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Registration</targetReference>
        </connector>
        <fields>
            <name>Review_Header</name>
            <fieldText>&lt;p&gt;&lt;strong style="font-size: 16px;"&gt;Review &amp;amp; Submit Registration&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Please confirm your details before completing reservation.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Review_Summary</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Ticket Type:&lt;/strong&gt; {!varTicketType.Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Amount Payable:&lt;/strong&gt; ${!varTicketType.Price__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Attendee Name:&lt;/strong&gt; {!Attendee_Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Email Address:&lt;/strong&gt; {!Attendee_Email}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Registration_Successful</name>
        <label>Registration Submitted</label>
        <locationX>170</locationX>
        <locationY>1524</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Text</name>
            <fieldText>&lt;p style="color: #0284c7; font-weight: bold; font-size: 16px;"&gt;Registration Reserved!&lt;/p&gt;&lt;p&gt;Your registration has been created in Pending status. Click Finish to proceed to QR payment verification.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Registration_Failed</name>
        <label>Registration Failed</label>
        <locationX>434</locationX>
        <locationY>1524</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Failure_Text</name>
            <fieldText>&lt;p style="color: #d9534f; font-weight: bold; font-size: 16px;"&gt;Registration Failed&lt;/p&gt;&lt;p&gt;We were unable to complete your reservation. This ticket type may have just sold out or registration is currently closed.&lt;/p&gt;&lt;p style="font-size: 12px; color: #64748b;"&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>selectedTicketTypeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>currentAttendeeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outcome</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>newRegistrationId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varAttendeeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTicketType</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Ticket_Type__c</objectType>
    </variables>
    <variables>
        <name>varExistingAttendee</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Attendee__c</objectType>
    </variables>
</Flow>