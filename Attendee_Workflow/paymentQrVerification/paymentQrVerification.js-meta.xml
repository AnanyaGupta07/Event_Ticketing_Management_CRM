<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Payment QR Verification</masterLabel>
    <description>3-step QR payment verification component with scannable QR, unskippable 10-second timer, and confirmation handler.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen,lightningCommunity__Default">
            <property name="amount" type="String" label="Payment Amount" description="Formatted amount to pay" />
            <property name="registrationId" type="String" label="Registration ID" description="The Salesforce Id of the Registration record" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
